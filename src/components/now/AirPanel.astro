---
import Panel from "./Panel.astro";
---

<Panel heading="air / haze" status="air-status">
  <div id="air"></div>
</Panel>

<style is:global>
  /* Rendered by the controller at runtime — see BusPanel for the scoping
     rationale. The dot's colour always gets a band name in text too; colour
     is never the only carrier. */
  .now-board .dot {
    display: inline-block;
    width: 0.62em;
    height: 0.62em;
    border-radius: 50%;
    margin-right: 0.3em;
    vertical-align: baseline;
    background: var(--rule);
  }

  .now-board .dot.g {
    background: var(--aqi-good);
  }

  .now-board .dot.e {
    background: var(--aqi-elev);
  }

  .now-board .dot.h {
    background: var(--aqi-high);
  }
</style>
