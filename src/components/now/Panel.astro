---
/* Every board panel is the same shell: a rule-topped section, a small-caps
   mono heading, the panel's content, and its live status line. The shell
   belongs here once — panels slot their own content in. The status line's
   look lives with the page's shared-runtime styles, since the controller
   also creates status paragraphs outside this template. */
interface Props {
  id?: string;
  heading: string;
  status?: string;
}

const { id, heading, status } = Astro.props;
---

<section id={id}>
  <h2>{heading}</h2>
  <slot />
  {status && <p class="status" id={status} role="status" />}
</section>

<style>
  section {
    margin-block: 2.1rem;
    padding-block-start: 0.85rem;
    border-block-start: 1px solid var(--rule);
    /* the site's global.css rises bare `section`s into view on load — the
       board sits still like the prototype did */
    animation: none;
  }

  h2 {
    font-family: "Space Mono", monospace;
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.85rem;
  }
</style>
