---
import Panel from "./Panel.astro";
---

<Panel heading="buses" status="buses-status">
  <div id="buses"></div>
</Panel>

<style is:global>
  /* The controller builds the stop cards at runtime — Astro scoping cannot
     reach DOM that isn't in this template, so these stay global, anchored
     under .now-board. */
  .now-board .stop {
    border: 2px solid var(--rule);
    border-radius: 12px;
    background: var(--panel);
    padding: 0.75rem 0.9rem;
    margin-block-end: 0.6rem;
  }

  .now-board .stop h3 {
    font-size: 0.95rem;
    font-weight: 500;
    margin: 0 0 0.3rem;
    color: var(--deep);
  }

  .now-board .stop .svcs {
    font-family: "Space Mono", monospace;
    font-size: 0.72rem;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }

  .now-board .stop ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }

  .now-board .stop ol li {
    font-family: "Space Mono", monospace;
    font-size: 0.85rem;
    color: var(--fg);
  }

  .now-board .stop ol li b {
    color: var(--deep);
  }
</style>
