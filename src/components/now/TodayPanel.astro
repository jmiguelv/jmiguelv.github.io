---
import Panel from "./Panel.astro";
---

<Panel heading="today" status="today-status">
  <div id="today"></div>
</Panel>

<style is:global>
  /* Rendered by the controller at runtime — see BusPanel for the scoping
     rationale. */
  .now-board .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.2rem;
    margin: 0.3rem 0 0;
  }

  .now-board .chip {
    font-family: "Space Mono", monospace;
    font-size: 0.78rem;
    color: var(--fg);
  }

  .now-board .chip b {
    color: var(--deep);
  }

  .now-board .chip small {
    display: block;
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
  }
</style>
