---
import { getCollection } from "astro:content";
import { Content as About, frontmatter } from "../content/about.md";
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ProjectItem from "../components/ProjectItem.astro";
import PublicationItem from "../components/PublicationItem.astro";
import { sortProjects, sortPublications } from "../utils/sort";

const projectEntries = await getCollection("projects");
const projects = projectEntries.map((e) => e.data).sort(sortProjects);

const publicationEntries = await getCollection("publications");
const publications = publicationEntries
  .map((e) => e.data)
  .sort(sortPublications);
---

<Base
  title="Miguel Vieira — Research Software Engineer"
  description={frontmatter.description}
>
  <SiteHeader />

  <main id="main">
    <section class="about" aria-labelledby="about">
      <h2 id="about">About</h2>
      <About />
    </section>

    <section aria-labelledby="projects">
      <h2 id="projects">Selected Work</h2>
      <ul class="projects-list">
        {
          projects.map((p) => (
            <li>
              <ProjectItem
                title={p.title}
                links={p.links}
                startYear={p.startYear}
                endYear={p.endYear}
                summary={p.summary}
              />
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="publications">
      <h2 id="publications">Research Outputs</h2>
      <ul class="publications-list">
        {
          publications.map((p) => (
            <li>
              <PublicationItem
                title={p.title}
                authors={p.authors}
                year={p.year}
                venue={p.venue}
                url={p.url}
                type={p.type}
              />
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <SiteFooter />
</Base>
