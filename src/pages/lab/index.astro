---
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { Content as Intro, frontmatter } from "../../content/lab/index.md";
import Base from "../../layouts/Base.astro";
import { discoverAllLabEntries } from "../../utils/lab";

/* The listing reads both sources at build time: the public/lab prototypes
   from their own HTML, the Astro lab pages from their own markup — no
   second copy of the list to go stale. */
const entries = discoverAllLabEntries("public/lab", "src/pages/lab");
---

<Base title="Lab — Miguel Vieira" description={frontmatter.description}>
  <SiteHeader />

  <main id="main">
    <section class="about" aria-labelledby="lab">
      <h2 id="lab">Lab</h2>
      <Intro />
    </section>

    <section aria-labelledby="experiments">
      <h2 id="experiments">Experiments</h2>
      <ul class="lab-list">
        {
          entries.map((entry) => (
            <li>
              <a class="lab-title" href={`/lab/${entry.slug}/`}>
                {entry.title}
              </a>
              <span class="lab-slug">{`/lab/${entry.slug}/`}</span>
              <p class="lab-desc">{entry.description}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <SiteFooter />
</Base>
